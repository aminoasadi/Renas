# ============================================================
# RENAS PLATFORM — ENVIRONMENT CONFIGURATION
# Copy to .env and fill in real values. Never commit .env.
# ============================================================

APP_ENV=development

# ---- URLs ----
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
API_URL=http://localhost:3002
# Client-side (browser) code can only read NEXT_PUBLIC_* vars — the admin
# app's client components call the API directly with credentials:'include'
# rather than proxying through the admin server, so they need this too.
NEXT_PUBLIC_API_URL=http://localhost:3002
NEXT_PUBLIC_WEB_URL=http://localhost:3000

# ---- Database ----
DATABASE_URL=postgresql://renas:renas@localhost:5434/renas?schema=public

# ---- Sessions ----
SESSION_SECRET=change-me-to-a-long-random-string-in-every-environment
SESSION_COOKIE_NAME=renas_session
SESSION_TTL_HOURS=12

# ---- OTP ----
OTP_TTL_MINUTES=5
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_RATE_LIMIT_PER_HOUR=5

# ---- SMTP (Mailpit locally, real SMTP provider in production) ----
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="RENAS <no-reply@renasxgroup.com>"

# Internal team address that receives RFQ / contact notifications
NOTIFICATIONS_TEAM_EMAIL=team@renasxgroup.com

# ---- Object storage (S3-compatible; MinIO locally) ----
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=renas-media
S3_ACCESS_KEY_ID=renas-minio
S3_SECRET_ACCESS_KEY=renas-minio-secret
S3_PUBLIC_URL=http://localhost:9000/renas-media
S3_FORCE_PATH_STYLE=true

# ---- Anti-spam (optional; leave blank to disable in development) ----
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ---- Analytics (optional) ----
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CLARITY_ID=

# ---- Seed ----
SEED_ADMIN_EMAIL=admin@renasxgroup.com

# ---- Next.js preview / revalidation ----
PREVIEW_SECRET=change-me-preview-secret
REVALIDATE_SECRET=change-me-revalidate-secret
